	"notes": {
		"5cd56f4e-4152-4556-b346-cd90045f870a": {
			"id": "5cd56f4e-4152-4556-b346-cd90045f870a",
			"visible": true,
			"name": "Hotelia ER - title",
			"desc": "<h1>HOTELIA</h1><p>MongoDB / Mongoose backend ER model &nbsp; | &nbsp; 14 collections &nbsp; | &nbsp; 2026-10-14</p>",
			"lines": [],
			"type": "Note",
			"assetCategory": "none",
			"assetType": ""
		},
		"cd24ae10-869e-4e3d-b290-0b4150f91f2d": {
			"id": "cd24ae10-869e-4e3d-b290-0b4150f91f2d",
			"visible": true,
			"name": "Model rules",
			"desc": "<h2>MODEL RULES</h2><p>Orange: members / hotels / rooms / bookings. Blue: supporting collections.</p><p>NN = Mongoose required:true; key = identifier/reference; enum = permitted values.</p><p>References are logical MongoDB links. Group-based targets are alternatives.</p><p>Favorites = likes (HOTEL). Reviews = comments (HOTEL, completed booking).</p><p>Availability: checkIn &lt; existingCheckOut AND checkOut &gt; existingCheckIn.</p><p>Overlapping reserved rooms must not exceed roomQuantity.</p><p>15-minute free cancellation; auto-confirm; later guest fee 5%. USD.</p><p>paymentCards: demo metadata only; no PAN or CVV, no real charge.</p><p>Exact indexes and field defaults are in collection/field descriptions.</p>",
			"lines": [],
			"type": "Note",
			"assetCategory": "none",
			"assetType": ""
		}
	},
