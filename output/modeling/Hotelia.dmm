		"de1270b5-ea74-46ba-bff1-525b5cb23169": {
			"id": "de1270b5-ea74-46ba-bff1-525b5cb23169",
			"visible": true,
			"name": "bookings",
			"desc": "Half-open date range [checkIn, checkOut). Backend computes nights and totalPrice. Free cancellation for 15 minutes; automatic confirmation after that deadline; later guest cancellation fee is 5%. Demo payment only, no real charge. Legacy bookings may lack payment fields.\n\nIndexes:\n{\"roomId\":1,\"bookingStatus\":1,\"checkIn\":1,\"checkOut\":1} {\"background\":true}\n{\"memberId\":1,\"createdAt\":-1} {\"background\":true}\n{\"hotelId\":1,\"createdAt\":-1} {\"background\":true}\n{\"bookingStatus\":1,\"freeCancellationUntil\":1} {\"background\":true}\n{\"bookingStatus\":1,\"expiresAt\":1} {\"background\":true}\n{\"memberId\":1,\"requestId\":1} {\"unique\":true,\"partialFilterExpression\":{\"requestId\":{\"$type\":\"string\"}},\"background\":true}",
